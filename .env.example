# ──────────────────────────────────────────────────────────────
# TutorIAs — variables de entorno
# Copiá este archivo a ".env" y completá los valores.
# La app FUNCIONA sin nada de esto (modo invitado: estado en el
# navegador). Para persistir cuentas/progreso y usar la IA real,
# completá las dos secciones de abajo.
# ──────────────────────────────────────────────────────────────

# ── 1) Base de datos — PostgreSQL en Neon (gratis) ─────────────
# De dónde sacarla:
#   1. Entrá a https://neon.tech y creá una cuenta (gratis).
#   2. "Create project" → te da una "Connection string".
#   3. Pegala acá abajo (usá el host con "-pooler" y sslmode=require).
#   4. Creá las tablas:  npm run db:push     (o:  npm run db:migrate)
# Sin esto, la app corre en modo invitado (sin login real / sin guardar).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ── 2) IA — Google Gemini (gratis) ─────────────────────────────
# De dónde sacarla:
#   1. Entrá a https://aistudio.google.com/apikey
#   2. "Create API key" → copiala.
# Sin esto, Squeaky responde con respuestas de respaldo (sin IA real).
GEMINI_API_KEY="reemplazar-por-tu-api-key"
# Modelo (opcional, default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# ── URL pública (opcional) ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
